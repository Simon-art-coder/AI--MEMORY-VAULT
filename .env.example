# Copy this file to .env and fill in real values. Never commit .env.

# --- Security ---
SECRET_KEY=change-me-to-a-long-random-string

# --- Database ---
# SQLite by default — zero setup needed for local development.
DATABASE_URL=sqlite:///./memory_vault.db
# When you're ready for PostgreSQL (needed for pgvector at scale), swap to:
# DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/memory_vault

# --- AI providers (optional — the app degrades honestly without these) ---
# Required for: RAG answer generation (/chat), fact extraction (/memories/{id}/extract)
ANTHROPIC_API_KEY=
# Optional — enables real semantic embeddings for /search. Without it,
# search falls back to a local lexical-only embedding (see README).
OPENAI_API_KEY=

# --- Redis / background jobs (not used yet — ingestion runs synchronously) ---
REDIS_URL=redis://localhost:6379/0
